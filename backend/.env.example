# ── Database (Railway provides DATABASE_URL automatically) ──────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forexbot

# ── Trading Mode ────────────────────────────────────────────────────────────
# simulate   = built-in price simulator, no external connection needed
# demo       = connect to MetaAPI (demo account)
# live       = connect to MetaAPI (live account) — USE WITH CAUTION
TRADING_MODE=simulate

# ── MetaAPI (cloud MT5 bridge — works on Railway/Linux) ─────────────────────
# Sign up at https://metaapi.cloud, add your MT5 broker account,
# then copy the token and account ID from the MetaAPI dashboard.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# ── Direct MT5 (Windows-only alternative, leave blank on Railway) ───────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Bot defaults ─────────────────────────────────────────────────────────────
DEFAULT_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
DEFAULT_RISK_PERCENT=1.5
DEFAULT_MAX_TRADES=5
DEFAULT_TIMEFRAME=H1

# ── AI ────────────────────────────────────────────────────────────────────────
AI_CONFIDENCE_THRESHOLD=0.65
AI_LOOKBACK_BARS=200

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
SECRET_KEY=change-me-before-production
